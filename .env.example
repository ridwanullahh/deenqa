# ============================================================
# DeenQA - Environment Variables (example)
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ---- Admin credentials (env-based, required) ----
# Used by /admin/login to authenticate the platform administrator.
# In production the password MUST be a bcrypt hash.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_BCRYPT_HASH_OF_YOUR_PASSWORD

# ---- Admin session secret (random 32+ bytes hex) ----
# Used to sign the admin session JWT. Rotate if leaked.
ADMIN_SESSION_SECRET=replace-with-32-byte-hex-secret

# ---- Lightbase DB (production backend, required) ----
# When LIGHTBASE_API_KEY is non-empty, the DB layer uses Lightbase.
# When empty, the DB falls back to in-memory (local dev only — NEVER
# use in production).
LIGHTBASE_API_KEY=lb_live_replace_with_real_key
LIGHTBASE_BASE_URL=http://lightbase.80.225.189.74.sslip.io
LIGHTBASE_PROJECT=deenqa
LIGHTBASE_TENANT=default

# ---- GitHub DB (legacy fallback, local dev only) ----
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_OWNER=ridwanullahh
GITHUB_REPO=deenqa
GITHUB_BRANCH=main

# ---- Cloudinary (optional - for question image uploads) ----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-upload-preset
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name

# ---- Cloudflare Pages deployment (used by the deploy script) ----
CLOUDFLARE_ACCOUNT_ID=15e9c5b50883ba36464fef9aa90937e1
CLOUDFLARE_API_TOKEN=replace-with-real-token
CLOUDFLARE_PROJECT_NAME=deenqa

# ---- App config ----
NEXT_PUBLIC_APP_URL=https://deenqa.pages.dev
NEXT_PUBLIC_APP_NAME=DeenQA
